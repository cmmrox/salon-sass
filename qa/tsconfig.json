{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/schema": ["../packages/api-contracts/src/generated/schema.ts"],
      "@qa/*": ["shared/*"]
    }
  },
  "include": ["playwright.config.ts", "api/**/*.ts", "web/**/*.ts", "shared/**/*.ts"]
}

# For running the web app by hand (`pnpm --filter @salon/web dev`): copy to .env.local.
# infra/scripts sets this itself, from the .env at the repository root.

# Where the API is. Read on the server at request time; never sent to the browser.
SALON_API_BASE_URL=http://localhost:8090

SALON_PLATFORM_DOMAIN=localhost
SALON_WEB_LOCAL_HTTP=true
SALON_WEB_TRUSTED_PROXIES=
# Retained local API key file; set an absolute path when using another checkout.
# SALON_IDENTITY_LOCAL_KEY_FILE=/absolute/path/.local/identity-keys.properties
# Nonlocal: SALON_IDENTITY_PROXY_KEY must be an explicit independent 64-hex secret.

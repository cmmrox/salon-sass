# Settings for the production-like stack. Copy this file to .env.stack (never committed) and fill
# in the database secrets. Local development defaults to HTTP only and does not create or trust
# certificates. The staging-only values below are ignored unless SALON_STACK_ENV=staging.
#
# Each secret below is empty here on purpose: the stack refuses to start, naming the setting, until
# it has a value. One way to make one: openssl rand -hex 24

# --- Versions -------------------------------------------------------------------------------------
# The version stack-up.sh starts when nothing has been deployed yet. After that, the versions
# running are the ones stack-deploy.sh deployed (.stack/deployed.env).
SALON_VERSION=0.1.0-SNAPSHOT
# Where the images come from: empty for images built on this machine (infra/scripts/images-build.sh);
# a registry and owner for a real host, for example ghcr.io/<owner>/ (with the trailing slash).
SALON_IMAGE_PREFIX=

# --- How the stack is reached ---------------------------------------------------------------------
# `local` selects the HTTP-only Caddy profile. Set to `staging` only on the authorized VPS deployment.
SALON_STACK_ENV=local
# The platform domain: salons are served at <slug>.<platform domain>. `stack.localhost` on the local
# machine, so that every salon's hostname resolves to this machine with no hosts file; the staging
# domain on a real host (D-02).
SALON_PLATFORM_DOMAIN=stack.localhost
# Local HTTP port. The staging edge publishes public ports 80 and 443 instead.
SALON_EDGE_HTTP_PORT=8089
# Local binds to loopback; set 0.0.0.0 for an authorized VPS staging deployment.
SALON_EDGE_PUBLISH_ADDRESS=127.0.0.1
# Staging-only TLS settings. Leave these blank for local development; they are required only when
# SALON_STACK_ENV=staging on the VPS. The image must include Caddy's selected DNS provider module.
SALON_EDGE_IMAGE=
SALON_EDGE_ACME_EMAIL=
SALON_EDGE_DNS_PROVIDER=
# Secret: the DNS provider's API credentials. Never set these on a local development stack.
SALON_EDGE_DNS_CREDENTIALS=
# The address range of the network the edge and the apps share. The API believes X-Forwarded-For and
# X-Forwarded-Proto only from it. Any private range no other network on the host uses.
SALON_STACK_EDGE_SUBNET=10.89.43.0/24

# --- The database ---------------------------------------------------------------------------------
# Optional dedicated database volume. The default preserves the existing stack database.
# Select a distinct name explicitly for an isolated local database; changing it does not migrate
# or delete the previous volume. Set this in .env.stack; shell variables are not read.
SALON_STACK_DB_VOLUME=salon-stack-postgres-data
SALON_DB_NAME=salon
# Where the API finds it: the stack's own PostgreSQL, or a managed database on a real host.
SALON_DB_URL=jdbc:postgresql://postgres:5432/salon
# The database's administrator: creates the two roles below (infra/postgres/provision-roles.sql).
SALON_DB_ADMIN_USER=salon_admin
# Secret.
SALON_DB_ADMIN_PASSWORD=
# The owning role: runs the migrations, owns every table, is not a superuser.
SALON_DB_USER=salon_owner
# Secret.
SALON_DB_PASSWORD=
# The application's role: what the API connects as; owns nothing, cannot get round row-level security.
SALON_DB_APP_USER=salon_app
# Secret.
SALON_DB_APP_PASSWORD=
# The platform runtime role of the operator console (F03-S01): a role of its own, provisioned by
# stack-up.sh beside the application role. Generate the password with: openssl rand -hex 24
SALON_DB_PLATFORM_USER=salon_platform
SALON_DB_PLATFORM_PASSWORD=

# Required independent 32-byte identity keys (64 hexadecimal characters each). No fallback.
SALON_IDENTITY_SIGNING_KEY=
SALON_IDENTITY_CHALLENGE_KEY=
SALON_IDENTITY_ENCRYPTION_KEY=

# Fourth independent 32-byte key shared by API and web BFF; never sent to browser.
SALON_IDENTITY_PROXY_KEY=
# Operator console keys (F03-S01): five more independent values, each from openssl rand -hex 32.
SALON_OPERATOR_SIGNING_KEY=
SALON_OPERATOR_CHALLENGE_KEY=
SALON_OPERATOR_ENCRYPTION_KEY=
SALON_OPERATOR_PROXY_KEY=
SALON_OPERATOR_FINGERPRINT_KEY=
# F03-S03: the export encryption key (openssl rand -hex 32), independent of every other key.
SALON_EXPORT_KEY=
# true only for this machine HTTP stack; false on real staging with TLS.
SALON_WEB_LOCAL_HTTP=true

{
  "name": "@salon/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "The pnpm workspace: the web app and the packages it shares. The API is built with Maven (apps/api); QA keeps its own package (qa/).",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts:check": "node packages/api-contracts/scripts/contracts.mjs check",
    "contracts:generate": "node packages/api-contracts/scripts/contracts.mjs generate",
    "format": "prettier --write apps/web packages",
    "format:check": "prettier --check apps/web packages",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}

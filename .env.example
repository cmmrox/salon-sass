# Settings of the local environment. Every one is optional: the value shown is the default.
# To change one, copy this file to .env (never committed) and edit it there, or set the variable
# in your shell, which wins over .env. infra/scripts and infra/docker-compose.yml read them.
#
# Nothing here is a secret. The database name, roles and passwords are local-only values for a
# database that is reachable from this machine alone.

# --- Ports on this machine ---
# PostgreSQL, published by Docker on 127.0.0.1 only.
SALON_POSTGRES_PORT=5440
# The API.
SALON_API_PORT=8090
# The web app.
SALON_WEB_PORT=3100

# --- The local database ---
SALON_DB_NAME=salon
# The owning role: the database's administrator. It runs the migrations and owns every table.
SALON_DB_USER=salon
SALON_DB_PASSWORD=salon-local-only
# The application's role: what the API connects as. It owns no table, is not a superuser and
# cannot get round row-level security; infra/scripts creates it (infra/postgres/application-role.sql).
# To look at the database the way the API sees it:
#   docker exec -e PGPASSWORD=salon-app-local-only salon-postgres psql -h localhost -U salon_app -d salon
SALON_DB_APP_USER=salon_app
SALON_DB_APP_PASSWORD=salon-app-local-only
# The platform runtime role (F03-S01): what the operator console's services connect as. A role of
# its own, granted only the platform tables it needs and the module-owned bootstrap functions; it
# has no access to salon tables. infra/scripts creates it beside the application's role.
SALON_DB_PLATFORM_USER=salon_platform
SALON_DB_PLATFORM_PASSWORD=salon-platform-local-only
# Optional size of its pool (default 4).
# SALON_DB_PLATFORM_POOL_SIZE=4

# --- Salons ---
# The platform domain: a salon is served at <slug>.<platform domain>. With `localhost`, the three
# synthetic salons of the local seed are alpha.localhost, beta.localhost and gamma.localhost, on
# the API's and the web app's ports, and need no hosts file.
SALON_PLATFORM_DOMAIN=localhost

# --- Who can reach the API and the web app ---
# `false` (the default): both listen on this machine's loopback addresses only, 127.0.0.1 and ::1.
# `true`: both listen on every network interface, so that a phone on the same network can open
# http://<this machine's address>:3100. Anyone else on that network can then reach them too.
SALON_LISTEN_ON_NETWORK=false

# --- Derived from the values above; set one only to point somewhere else ---
# The JDBC address the API connects to.
# SALON_DB_URL=jdbc:postgresql://localhost:5440/salon
# Where the web app's server finds the API.
# SALON_API_BASE_URL=http://localhost:8090

# --- How things are started ---
# The API's Spring profile. `local` exposes /actuator/info and the OpenAPI document at /v3/api-docs,
# and seeds the three synthetic salons; any other profile does none of these.
# SPRING_PROFILES_ACTIVE=local
# `production` builds the web app and serves the build (the default; what QA tests).
# `dev` runs the Next.js development server with hot reload.
# SALON_WEB_MODE=production

# --- Finding JDK 25 ---
# The scripts and the Maven build find JDK 25 on their own (SDKMAN, JAVA_HOME, the system's
# installed JDKs) and never change the machine's default Java. Set this only when it is installed
# somewhere they do not look.
# JAVA25_HOME=/path/to/jdk-25

# Staff identity: independent 32-byte keys encoded as 64 hex characters. Local startup retains
# generated keys under .local/identity-keys.properties unless explicitly configured.
# Nonlocal startup requires all three. Generate each with: openssl rand -hex 32
# SALON_IDENTITY_SIGNING_KEY=
# SALON_IDENTITY_CHALLENGE_KEY=
# SALON_IDENTITY_ENCRYPTION_KEY=

# Customer accepted-code request ceilings (production defaults; explicit overrides for controlled tests).
# SALON_IDENTITY_CODE_NUMBER_LIMIT=3
# SALON_IDENTITY_CODE_DEVICE_LIMIT=10
# SALON_IDENTITY_CODE_ADDRESS_LIMIT=20
# SALON_IDENTITY_CODE_DAILY_LIMIT=1000

# Browser boundary: local HTTP only. Outside local use false and explicit proxy key.
SALON_WEB_LOCAL_HTTP=true
SALON_WEB_TRUSTED_PROXIES=
SALON_IDENTITY_PROXY_KEY=

# Operator console (F03-S01): five independent 32-byte keys encoded as 64 hex characters, separate
# from every identity key: access-token signing, challenge/refresh hashing, MFA secret encryption,
# the operator sign-in address assertion shared by API and web, and idempotency fingerprints.
# Local startup retains generated keys in .local/operator-keys.properties unless configured;
# nonlocal startup requires all five. Generate each with: openssl rand -hex 32
# SALON_OPERATOR_SIGNING_KEY=
# SALON_OPERATOR_CHALLENGE_KEY=
# SALON_OPERATOR_ENCRYPTION_KEY=
# SALON_OPERATOR_PROXY_KEY=
# SALON_OPERATOR_FINGERPRINT_KEY=
# Salon exports (F03-S03): the 64-hex key that encrypts a closed salon's export at rest, independent of
# every other key. Local startup retains a generated one in .local/export-keys.properties
# (SALON_EXPORT_LOCAL_KEY_FILE) unless configured; nonlocal startup requires it. The Owner's email
# links to SALON_EXPORT_LINK_ORIGIN with the platform domain in place of %s (local http://%s:3100).
# SALON_EXPORT_KEY=
# SALON_EXPORT_LINK_ORIGIN=

{
  "components": {
    "schemas": {
      "AuditView": {
        "properties": {
          "action": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "actorKind": {
            "type": "string"
          },
          "after": {
            "additionalProperties": {},
            "type": "object"
          },
          "before": {
            "additionalProperties": {},
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "subjectKind": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChallengeRequest": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "challengeToken": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "challengeToken"
        ],
        "type": "object"
      },
      "ChangeStaffRequest": {
        "properties": {
          "professionalGrant": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          },
          "version": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      },
      "CreateStaffRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "mobile": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          },
          "professionalGrant": {
            "type": "boolean"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "password",
          "role"
        ],
        "type": "object"
      },
      "Enrollment": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "otpauthUri": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Meta": {
        "description": "What the running service says about itself.",
        "properties": {
          "commit": {
            "description": "The commit the build was made from, or `unknown` when the build had no repository.",
            "example": "e852c61f0c0e4d7a9b1f3c5d7e9a0b2c4d6e8f01",
            "type": "string"
          },
          "service": {
            "description": "The service's name.",
            "example": "salon-api",
            "type": "string"
          },
          "time": {
            "description": "The server's time: an ISO-8601 instant in UTC.",
            "example": "2026-10-12T02:17:00.123Z",
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "description": "The version the build was given.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "commit",
          "service",
          "time",
          "version"
        ],
        "type": "object"
      },
      "PageAuditView": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditView"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageSessionView": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionView"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageStaffView": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/StaffView"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PasswordRequest": {
        "properties": {
          "newPassword": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          },
          "oldPassword": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "newPassword",
          "oldPassword"
        ],
        "type": "object"
      },
      "Principal": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "mfaEnabled": {
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "role": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "staffId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Problem": {
        "description": "An error, as problem details (RFC 9457) with a stable machine-readable `code`.",
        "properties": {
          "code": {
            "description": "The stable reason. Branch on this.",
            "enum": [
              "invalid_credentials",
              "invalid_session",
              "permission_denied",
              "conflict",
              "rate_limited",
              "bad_request",
              "not_found",
              "method_not_allowed",
              "not_acceptable",
              "unsupported_media_type",
              "request_rejected",
              "service_unavailable",
              "salon_suspended",
              "internal_error"
            ],
            "type": "string"
          },
          "detail": {
            "description": "A sentence for a person. Do not branch on it.",
            "type": "string"
          },
          "errors": {
            "description": "For a request body that failed validation (`bad_request`): each field that failed, when the failure has a field. Never the value that was refused.",
            "items": {
              "properties": {
                "detail": {
                  "description": "What is wrong with it, for a person.",
                  "type": "string"
                },
                "field": {
                  "description": "The field, as the request names it; a dotted path when nested.",
                  "type": "string"
                }
              },
              "required": [
                "detail",
                "field"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "description": "The path that was requested.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the status.",
            "type": "string"
          },
          "traceId": {
            "description": "The request's trace id: the `trace.id` of its log lines and of its trace.",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736",
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          },
          "type": {
            "description": "A URI identifying the kind of problem.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "status",
          "title",
          "traceId"
        ],
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refreshToken": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "Salon": {
        "description": "The public brand of the salon the request's hostname names.",
        "properties": {
          "brandColour": {
            "description": "The salon's brand colour, `#RRGGBB`.",
            "example": "#D6086A",
            "pattern": "^#[0-9A-F]{6}$",
            "type": "string"
          },
          "name": {
            "description": "The salon's published display name.",
            "example": "Alpha Studio",
            "type": "string"
          },
          "slug": {
            "description": "The salon's slug: its subdomain on the platform domain.",
            "example": "alpha",
            "type": "string"
          },
          "timeZone": {
            "description": "The salon's time zone, an IANA name. The salon's times are shown in it.",
            "example": "Asia/Colombo",
            "type": "string"
          }
        },
        "required": [
          "brandColour",
          "name",
          "slug",
          "timeZone"
        ],
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "deviceLabel": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SignIn": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "challengeToken": {
            "type": "string"
          },
          "credentials": {
            "$ref": "#/components/schemas/Tokens"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SignInRequest": {
        "properties": {
          "deviceLabel": {
            "maxLength": 160,
            "minLength": 0,
            "type": "string"
          },
          "identifier": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "deviceLabel",
          "identifier",
          "password"
        ],
        "type": "object"
      },
      "StaffView": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "mfaEnabled": {
            "type": "boolean"
          },
          "mobile": {
            "type": "string"
          },
          "professionalGrant": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Tokens": {
        "properties": {
          "accessExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "accessToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "sessionId": {
            "format": "uuid",
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "VerifyRequest": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "challengeToken": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "code": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "challengeToken",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The platform's REST API. Every error is problem details with a stable `code`.",
    "title": "salon-api",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/identity/audit": {
      "get": {
        "operationId": "audit",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "subjectId",
            "required": false,
            "schema": {
              "maxLength": 128,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageAuditView"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Any error: problem details with a stable `code`."
          }
        },
        "tags": [
          "staff-access-controller"
        ]
      }
    },

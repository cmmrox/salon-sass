# Public staging edge only. Local development uses Caddyfile and never starts this configuration.
{
	admin localhost:2019
	servers {
		protocols h1 h2
	}
}

(certificates-acme-dns) {
	tls {$SALON_EDGE_ACME_EMAIL} {
		dns {$SALON_EDGE_DNS_PROVIDER} {$SALON_EDGE_DNS_CREDENTIALS}
	}
}

# One JSON line per request on standard output (docker logs salon-stack-edge), so that a failed
# or slow request can be traced to the instance that answered it. Nothing personal or secret: no
# header (cookies, authorization, user agent), no client address, no query string, and the token
# of an export download link (/api/v1/exports/<token>) is cut from the path.
(access-log) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "^(?:(.*/exports/)[^/?]+)?([^?]*).*$" "${1}${2}"
			request>headers delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>tls delete
			resp_headers delete
			user_id delete
		}
	}
	log_append upstream {rp.upstream.hostport}
	log_append upstream_duration_ms {rp.upstream.duration_ms}
}

(instances) {
	# The instance with the fewest requests in flight (BUG-F01-009): one that answers slowly, because
	# it has only just started or is busy, is given less, instead of half of every request and a
	# queue the other instance does not have.
	lb_policy least_conn
	lb_retries 2
	lb_try_duration 5s
	lb_try_interval 100ms
	fail_duration 10s
	health_uri {args[0]}
	health_interval 1s
	# A stopping instance answers not-ready at once, so it leaves the rotation within health_fails
	# seconds. A busy one that still answers, perhaps slowly, stays in it: under a burst, health
	# checks wait in the same queue as requests, and a check timeout must not remove an instance
	# that is still answering (BUG-F01-009).
	health_timeout 5s
	# A single transient readiness response must not eject the only remaining instance during rollout.
	health_fails 3
	health_passes 1
	header_up -X-Forwarded-Host
	transport http {
		dial_timeout 2s
	}
}

{$SALON_PLATFORM_DOMAIN}, *.{$SALON_PLATFORM_DOMAIN} {
	import certificates-acme-dns
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
	import access-log
	@api path /api /api/* /actuator /actuator/* /local /local/*
	handle @api {
		reverse_proxy api-1:8080 api-2:8080 {
			import instances /actuator/health/readiness
		}
	}
	handle {
		# web-surge serves only during a deployment (stack-deploy.sh); otherwise it is down here.
		reverse_proxy web-1:3000 web-2:3000 web-surge:3000 {
			import instances /healthz
		}
	}
}

http://{$SALON_PLATFORM_DOMAIN}, http://*.{$SALON_PLATFORM_DOMAIN} {
	header -Server
	import access-log
	redir https://{host}{uri} 308
}

http://:8080 {
	header -Server
	import access-log
	reverse_proxy api-1:8080 api-2:8080 {
		import instances /actuator/health/readiness
	}
}
